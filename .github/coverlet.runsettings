<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>opencover</Format>
					<Include>[Dreamine.UI.Wpf]*</Include>
					<Exclude>[*.Tests]*</Exclude>
					<ExcludeByFile>**/obj/**,**/bin/**,**/Behaviors/**,**/Controls/**,**/Localization/**</ExcludeByFile>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
